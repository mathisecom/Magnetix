<section
  id="benefits-bar-{{ section.id }}"
  class="benefits-bar"
  style="
    --bar-bg: {{ section.settings.bg_color }};
    --bar-text: {{ section.settings.text_color }};
  "
>

  <div class="benefits-bar__viewport">

    <div class="benefits-bar__track">

      <div class="benefits-bar__group">

        <!-- LIVRAISON RAPIDE -->
        <div class="benefits-bar__item">

          <span class="benefits-bar__icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 6h11v8h-1.5a2.5 2.5 0 0 0-5 0H6a2.5 2.5 0 0 0-5 0H1V8a2 2 0 0 1 2-2Zm11 3h3.5l2.5 2.5V14H19a2.5 2.5 0 0 0-5 0h-1V9Zm-8 7.5A1.5 1.5 0 1 1 6 13.5a1.5 1.5 0 0 1 0 3Zm11 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z"
                fill="currentColor"
              />
            </svg>
          </span>

          <span class="benefits-bar__text">
            {{ section.settings.text_1 }}
          </span>

        </div>


        <!-- SATISFAIT OU REMBOURSÉ -->
        <div class="benefits-bar__item">

          <span class="benefits-bar__icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h1V3a1 1 0 0 1 1-1Zm13 8H4v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8ZM5 6a1 1 0 0 0-1 1v1h16V7a1 1 0 0 0-1-1H5Z"
                fill="currentColor"
              />
            </svg>
          </span>

          <span class="benefits-bar__text">
            {{ section.settings.text_2 }}
          </span>

        </div>


        <!-- GARANTIE -->
        <div class="benefits-bar__item">

          <span class="benefits-bar__icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 2 4 5v6c0 5.25 3.4 10.15 8 11 4.6-.85 8-5.75 8-11V5l-8-3Zm0 2.1 6 2.25V11c0 4.19-2.6 8.1-6 8.95C8.6 19.1 6 15.19 6 11V6.35l6-2.25Z"
                fill="currentColor"
              />
            </svg>
          </span>

          <span class="benefits-bar__text">
            {{ section.settings.text_3 }}
          </span>

        </div>

      </div>

    </div>

  </div>

</section>


<style>

  /* =========================
     BARRE GÉNÉRALE
  ========================== */

  #benefits-bar-{{ section.id }} {
    width: 100%;

    background: var(--bar-bg);
    color: var(--bar-text);

    overflow: hidden;

    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }


  #benefits-bar-{{ section.id }} .benefits-bar__viewport {
    width: 100%;

    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }


  #benefits-bar-{{ section.id }} .benefits-bar__track {
    width: 100%;

    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }



  /* =========================
     DESKTOP
  ========================== */

  #benefits-bar-{{ section.id }} .benefits-bar__group {
    width: 100%;

    min-height: 42px;

    display: flex;
    align-items: center;
    justify-content: space-evenly;

    gap: 30px;

    padding: 7px 30px;

    box-sizing: border-box;

    border: none !important;
  }


  #benefits-bar-{{ section.id }} .benefits-bar__item {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    white-space: nowrap;

    border: none !important;
  }


  #benefits-bar-{{ section.id }} .benefits-bar__icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 17px;
    height: 17px;

    flex: 0 0 17px;
  }


  #benefits-bar-{{ section.id }} .benefits-bar__icon svg {
    width: 17px;
    height: 17px;

    display: block;
  }


  #benefits-bar-{{ section.id }} .benefits-bar__text {
    font-size: 11px;

    line-height: 1.2;

    font-weight: 700;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }



  /* =========================
     TABLETTE
  ========================== */

  @media screen and (max-width: 990px) {

    #benefits-bar-{{ section.id }} .benefits-bar__group {
      gap: 20px;

      padding-left: 20px;
      padding-right: 20px;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__text {
      font-size: 10.5px;

      letter-spacing: 0.05em;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__icon {
      width: 16px;
      height: 16px;

      flex: 0 0 16px;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__icon svg {
      width: 16px;
      height: 16px;
    }

  }



  /* =========================
     MOBILE
     DÉFILEMENT MANUEL
  ========================== */

  @media screen and (max-width: 749px) {

    #benefits-bar-{{ section.id }} {
      border: none !important;

      box-shadow: none !important;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__viewport {
      width: 100%;

      overflow-x: auto;
      overflow-y: hidden;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;

      scroll-behavior: smooth;

      border: none !important;

      box-shadow: none !important;
    }


    #benefits-bar-{{ section.id }}
    .benefits-bar__viewport::-webkit-scrollbar {
      display: none;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__track {
      width: max-content;

      display: flex;

      animation: none !important;

      transform: none !important;

      border: none !important;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__group {
      width: max-content;

      min-height: 40px;

      display: flex;

      align-items: center;

      justify-content: flex-start;

      gap: 32px;

      padding: 8px 18px;

      flex-shrink: 0;

      box-sizing: border-box;

      border: none !important;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__item {
      flex-shrink: 0;

      display: flex;

      align-items: center;

      gap: 7px;

      white-space: nowrap;

      border: none !important;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__text {
      font-size: 10px;

      line-height: 1.2;

      font-weight: 700;

      letter-spacing: 0.05em;

      text-transform: uppercase;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__icon {
      width: 15px;
      height: 15px;

      flex: 0 0 15px;
    }


    #benefits-bar-{{ section.id }} .benefits-bar__icon svg {
      width: 15px;
      height: 15px;
    }

  }

</style>


{% schema %}
{
  "name": "Barre avantages",

  "settings": [

    {
      "type": "header",
      "content": "Textes"
    },

    {
      "type": "text",
      "id": "text_1",
      "label": "Avantage 1",
      "default": "Livraison rapide"
    },

    {
      "type": "text",
      "id": "text_2",
      "label": "Avantage 2",
      "default": "60 jours satisfait ou remboursé"
    },

    {
      "type": "text",
      "id": "text_3",
      "label": "Avantage 3",
      "default": "Garantie 1 an incluse"
    },


    {
      "type": "header",
      "content": "Couleurs"
    },

    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#F6F6F6"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#1A1A1A"
    }

  ],


  "presets": [

    {
      "name": "Barre avantages"
    }

  ]

}
{% endschema %}