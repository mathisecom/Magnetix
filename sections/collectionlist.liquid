<section
  id="categories-{{ section.id }}"
  class="magnetix-categories"
>
  <div class="magnetix-categories__container">

    {% if section.settings.title != blank %}
      <h2 class="magnetix-categories__title">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div class="magnetix-categories__scroll">

      <div class="magnetix-categories__list">

        {% for block in section.blocks %}

          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="magnetix-category"
              {{ block.shopify_attributes }}
            >
          {% else %}
            <div
              class="magnetix-category"
              {{ block.shopify_attributes }}
            >
          {% endif %}

            <div class="magnetix-category__image-wrapper">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '100, 150, 200, 300, 400',
                    class: 'magnetix-category__image',
                    alt: block.settings.title
                }}

              {% else %}

                <div class="magnetix-category__placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>

              {% endif %}

            </div>

            {% if block.settings.title != blank %}
              <div class="magnetix-category__name">
                {{ block.settings.title }}
              </div>
            {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>
</section>


<style>

  /* ==============================
     SECTION
  ============================== */

  #categories-{{ section.id }} {
    width: 100%;

    background: {{ section.settings.section_background }};

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    overflow: hidden;
  }


  #categories-{{ section.id }} .magnetix-categories__container {
    width: 100%;

    max-width: {{ section.settings.max_width }}px;

    margin: 0 auto;

    padding-left: 24px;
    padding-right: 24px;

    box-sizing: border-box;
  }



  /* ==============================
     TITRE
  ============================== */

  #categories-{{ section.id }} .magnetix-categories__title {
    margin: 0 0 {{ section.settings.title_spacing }}px;

    text-align: center;

    color: {{ section.settings.title_color }};

    font-size: {{ section.settings.title_size }}px;

    line-height: 1.15;

    font-weight: {{ section.settings.title_weight }};

    letter-spacing: -0.02em;
  }



  /* ==============================
     LISTE
  ============================== */

  #categories-{{ section.id }} .magnetix-categories__scroll {
    width: 100%;
  }


  #categories-{{ section.id }} .magnetix-categories__list {
    display: flex;

    align-items: stretch;
    justify-content: center;

    gap: {{ section.settings.desktop_gap }}px;

    width: 100%;
  }



  /* ==============================
     CARTE
  ============================== */

  #categories-{{ section.id }} .magnetix-category {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    width: {{ section.settings.card_width }}px;
    min-width: {{ section.settings.card_width }}px;

    height: {{ section.settings.card_height }}px;

    padding:
      {{ section.settings.card_padding_top }}px
      12px
      {{ section.settings.card_padding_bottom }}px;

    box-sizing: border-box;

    background: {{ section.settings.card_background }};

    border-radius: {{ section.settings.card_radius }}px;

    color: {{ section.settings.text_color }};

    text-decoration: none;

    overflow: hidden;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;

    -webkit-tap-highlight-color: transparent;
  }


  #categories-{{ section.id }} a.magnetix-category:hover {
    transform: translateY(-3px);

    {% if section.settings.hover_shadow %}
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    {% endif %}
  }



  /* ==============================
     IMAGE
  ============================== */

  #categories-{{ section.id }} .magnetix-category__image-wrapper {
    width: 100%;

    height: {{ section.settings.image_height }}px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;
  }


  #categories-{{ section.id }} .magnetix-category__image {
    display: block;

    width: auto;
    height: auto;

    max-width: {{ section.settings.image_width }}px;
    max-height: {{ section.settings.image_height }}px;

    object-fit: contain;
  }


  #categories-{{ section.id }} .magnetix-category__placeholder {
    width: 70px;
    height: 70px;

    opacity: 0.25;
  }


  #categories-{{ section.id }} .magnetix-category__placeholder svg {
    width: 100%;
    height: 100%;
  }



  /* ==============================
     TEXTE CARTE
  ============================== */

  #categories-{{ section.id }} .magnetix-category__name {
    width: 100%;

    margin-top: 8px;

    text-align: center;

    font-size: {{ section.settings.text_size }}px;

    font-weight: {{ section.settings.text_weight }};

    line-height: 1.2;

    color: {{ section.settings.text_color }};

    overflow: hidden;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }



  /* ==============================
     TABLETTE
  ============================== */

  @media screen and (max-width: 1100px) {

    #categories-{{ section.id }} .magnetix-categories__scroll {
      overflow-x: auto;
      overflow-y: hidden;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;
    }


    #categories-{{ section.id }} .magnetix-categories__scroll::-webkit-scrollbar {
      display: none;
    }


    #categories-{{ section.id }} .magnetix-categories__list {
      width: max-content;

      justify-content: flex-start;

      padding-right: 24px;
    }

  }



  /* ==============================
     MOBILE
  ============================== */

  @media screen and (max-width: 749px) {

    #categories-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    #categories-{{ section.id }} .magnetix-categories__container {
      padding-left: 16px;
      padding-right: 0;
    }


    #categories-{{ section.id }} .magnetix-categories__title {
      padding-right: 16px;

      margin-bottom: {{ section.settings.mobile_title_spacing }}px;

      font-size: {{ section.settings.mobile_title_size }}px;

      text-align: {{ section.settings.mobile_title_alignment }};
    }


    /* Défilement manuel au doigt */

    #categories-{{ section.id }} .magnetix-categories__scroll {
      width: 100%;

      overflow-x: auto;
      overflow-y: hidden;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;

      scroll-behavior: smooth;

      scroll-snap-type: x proximity;
    }


    #categories-{{ section.id }} .magnetix-categories__scroll::-webkit-scrollbar {
      display: none;
    }


    #categories-{{ section.id }} .magnetix-categories__list {
      display: flex;

      width: max-content;

      justify-content: flex-start;

      gap: {{ section.settings.mobile_gap }}px;

      padding-right: 16px;
    }


    #categories-{{ section.id }} .magnetix-category {
      width: {{ section.settings.mobile_card_width }}px;
      min-width: {{ section.settings.mobile_card_width }}px;

      height: {{ section.settings.mobile_card_height }}px;

      border-radius: {{ section.settings.mobile_card_radius }}px;

      padding: 12px 8px 10px;

      scroll-snap-align: start;
    }


    #categories-{{ section.id }} .magnetix-category__image-wrapper {
      height: {{ section.settings.mobile_image_height }}px;
    }


    #categories-{{ section.id }} .magnetix-category__image {
      max-width: {{ section.settings.mobile_image_width }}px;
      max-height: {{ section.settings.mobile_image_height }}px;
    }


    #categories-{{ section.id }} .magnetix-category__name {
      margin-top: 6px;

      font-size: {{ section.settings.mobile_text_size }}px;
    }

  }

</style>


{% schema %}
{
  "name": "Catégories produits",
  "max_blocks": 12,

  "settings": [

    {
      "type": "header",
      "content": "Titre"
    },

    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Découvrez nos produits par catégorie"
    },

    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#000000"
    },

    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre sur ordinateur",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },

    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Taille du titre sur mobile",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },

    {
      "type": "select",
      "id": "title_weight",
      "label": "Épaisseur du titre",
      "default": "700",
      "options": [
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        },
        {
          "value": "800",
          "label": "Très gras"
        }
      ]
    },

    {
      "type": "select",
      "id": "mobile_title_alignment",
      "label": "Alignement du titre sur mobile",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },

    {
      "type": "range",
      "id": "title_spacing",
      "label": "Espace sous le titre",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 22
    },

    {
      "type": "range",
      "id": "mobile_title_spacing",
      "label": "Espace sous le titre sur mobile",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },


    {
      "type": "header",
      "content": "Cartes"
    },

    {
      "type": "color",
      "id": "section_background",
      "label": "Fond de la section",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "card_background",
      "label": "Fond des cartes",
      "default": "#F5F6F7"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#111111"
    },

    {
      "type": "range",
      "id": "card_width",
      "label": "Largeur des cartes",
      "min": 110,
      "max": 220,
      "step": 5,
      "unit": "px",
      "default": 155
    },

    {
      "type": "range",
      "id": "card_height",
      "label": "Hauteur des cartes",
      "min": 120,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 155
    },

    {
      "type": "range",
      "id": "card_radius",
      "label": "Arrondi des cartes",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "card_padding_top",
      "label": "Marge intérieure haute",
      "min": 5,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "card_padding_bottom",
      "label": "Marge intérieure basse",
      "min": 5,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Espace entre les cartes",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "checkbox",
      "id": "hover_shadow",
      "label": "Ombre au survol",
      "default": true
    },


    {
      "type": "header",
      "content": "Images"
    },

    {
      "type": "range",
      "id": "image_width",
      "label": "Largeur maximale des images",
      "min": 40,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Hauteur maximale des images",
      "min": 40,
      "max": 130,
      "step": 5,
      "unit": "px",
      "default": 80
    },


    {
      "type": "header",
      "content": "Texte des catégories"
    },

    {
      "type": "range",
      "id": "text_size",
      "label": "Taille du texte",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "select",
      "id": "text_weight",
      "label": "Épaisseur du texte",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ]
    },


    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Largeur des cartes sur mobile",
      "min": 90,
      "max": 170,
      "step": 5,
      "unit": "px",
      "default": 120
    },

    {
      "type": "range",
      "id": "mobile_card_height",
      "label": "Hauteur des cartes sur mobile",
      "min": 100,
      "max": 190,
      "step": 5,
      "unit": "px",
      "default": 130
    },

    {
      "type": "range",
      "id": "mobile_card_radius",
      "label": "Arrondi sur mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Espace entre les cartes sur mobile",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "range",
      "id": "mobile_image_width",
      "label": "Largeur image sur mobile",
      "min": 35,
      "max": 110,
      "step": 5,
      "unit": "px",
      "default": 65
    },

    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Hauteur image sur mobile",
      "min": 35,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 65
    },

    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Taille du texte sur mobile",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },


    {
      "type": "header",
      "content": "Espacement de la section"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge supérieure",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge inférieure",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Marge supérieure mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 25
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Marge inférieure mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 25
    }

  ],

  "blocks": [

    {
      "type": "category",
      "name": "Catégorie",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Nom de la catégorie",
          "default": "Batteries externes"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }

      ]

    }

  ],

  "presets": [
    {
      "name": "Catégories produits",

      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Batteries externes"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Chargeurs"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Chargeurs sans fil"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Câbles"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Accessoires"
          }
        }
      ]
    }
  ]

}
{% endschema %}